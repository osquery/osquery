table_name("jdk_installations")
description("JDK (Java) Installations.")
schema([
    Column("uid", BIGINT, "The local user that owns the JDK", additional=True, optimized=True),
    Column("name", TEXT, "Name of the JDK"),
    Column("version", TEXT, "Version of the JDK", collate="version"),
    Column("vendor", TEXT, "The vendor name or organization id that authored the plugin"),
    Column("path", TEXT, "The path on the filesystem for the JDK."),
    Column("architecture", TEXT, "architecture of the JDK (x86_64 or aarch64)"),
])
attributes(user_data=True)
implementation("applications/jdk_installations@genJDK")
examples([
    "select * from users cross join jdk_installations using (uid)"
])
fuzz_paths([
    "/Library/Java/JavaVirtualMachines",
    "/Users/%/Library/Java/JavaVirtualMachines",
    "/Users/%/.jabba/jdk",
    "/Users/%/.sdkman/candidates/java",
    "%USERPROFILE%\\.jabba/jdk",
    "%USERPROFILE%\\.sdkman",
    "/home/%/.jabba/jdk",
    "/home/%/.sdkman/candidates/java"
])
