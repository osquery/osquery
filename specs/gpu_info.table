table_name("gpu_info")
description("Retrieve GPU (graphics processing unit) inventory information of the machine, reporting only stable attributes.")
schema([
    Column("device_id", TEXT, "The GPU identifier used to correlate rows with other GPU tables. Derived from the PCI slot address when available (e.g. GPU0000:01:00.0); macOS GPUs without a PCI slot use GPUintegrated, while other platforms use an enumeration-based fallback."),
    Column("name", TEXT, "The name of the GPU."),
    Column("vendor", TEXT, "The vendor of the GPU."),
    Column("vendor_id", TEXT, "The hex encoded PCI vendor identifier of the GPU."),
    Column("model", TEXT, "The model of the GPU."),
    Column("model_id", TEXT, "The hex encoded PCI model identifier of the GPU. On Apple Silicon, where the GPU is integrated in the SoC and has no PCI device ID, the IOKit SoC identifier is reported instead (e.g. gpu,t6000)."),
    Column("driver", TEXT, "The driver in use by the GPU."),
    Column("driver_version", TEXT, "The version of the installed driver.", collate="version"),
    Column("vram", BIGINT, "The total video memory of the GPU in bytes. Fixed capacity only: on Linux only available for AMD GPUs (amdgpu driver, via mem_info_vram_total sysfs) and for NVIDIA GPUs with the proprietary driver loaded (via NVML, the library behind nvidia-smi, which also requires the query to have permission to talk to the driver); Intel drivers expose no equivalent; on macOS empty for unified-memory GPUs (Apple Silicon), which have no dedicated VRAM"),
    Column("pci_slot", TEXT, "The PCI slot of the GPU, as a bus address (e.g. 0000:01:00.0 on Linux, 0000:bb:dd.f on Windows, b:d:f on macOS). Empty for non-PCI adapters (e.g. Apple Silicon integrated GPUs)."),
    Column("pci_class_id", TEXT, "The PCI class identifier of the GPU in hex format. Empty when the GPU has no PCI identity (e.g. Apple Silicon integrated GPUs) or when the platform does not expose the class code (Windows)."),
])
extended_schema(DARWIN, [
    Column("cores", INTEGER, "The number of GPU cores. Only available on macOS."),
    Column("metal_support", TEXT, "The Metal feature set supported by the GPU. Only available on macOS."),
])
extended_schema(WINDOWS, [
    Column("driver_date", BIGINT, "The date of the installed driver, as a Unix timestamp. Only available on Windows."),
])
implementation("gpu_info@genGpuInfo")