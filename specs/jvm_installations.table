table_name("jvm_installations")
description("Java Virtual Machine (JDK, JRE) Installations.")
schema([
    Column("uid", BIGINT, "The local user that owns the JVM", additional=True, optimized=True),
    Column("name", TEXT, "Name of the JVM"),
    Column("version", TEXT, "Version of the JVM", collate="version"),
    Column("vendor", TEXT, "The vendor name or organization that builds the JVM."),
    Column("path", TEXT, "The path on the filesystem for the JVM."),
    Column("architecture", TEXT, "architecture of the JVM (x86, aarch64, amd64, etc.)"),
])
attributes(user_data=True)
implementation("applications/jvm_installations@genJVM")
examples([
    "SELECT u.username, jvm.name, jvm.vendor, jvm.path, jvm.architecture FROM users u CROSS JOIN jvm_installations jvm  ON u.uid = jvm.uid;"
])
