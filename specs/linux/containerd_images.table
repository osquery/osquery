table_name("containerd_images")
description("Containerd images information.")
schema([
    Column("name", TEXT, "Image name", index=True),
    Column("namespace", TEXT, "Containerd namespace", index=True),
    Column("digest", TEXT, "Image digest (hash)"),
    Column("size", BIGINT, "Image size in bytes"),
    Column("media_type", TEXT, "Media type of the image"),
    Column("created_at", BIGINT, "Image creation time (seconds since epoch)"),
    Column("updated_at", BIGINT, "Image last update time (seconds since epoch)"),
])
implementation("applications/containerd@genContainerdImages")
examples([
  "select * from containerd_images",
  "select * from containerd_images where namespace = 'k8s.io'"
])
