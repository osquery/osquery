table_name("gpu_metrics")
description("Information about GPU devices on the system, including inventory and runtime telemetry where supported.")
schema([
  Column("device_id", TEXT, "The stable identifier of the GPU, used as the join key to correlate with GPU tables that report the same identifier. Derived from the PCI slot address when available (e.g. GPU0000:01:00.0), so it is stable across reboots; a positional GPU<n> counter is used only for GPUs without a slot, where the identifier is only stable within the same query result."),
  Column("gpu_utilization_pct", DOUBLE, "GPU engine utilization as a percentage (0-100)."),
])
extended_schema(POSIX, [
  Column("power_draw_watts", DOUBLE, "Current GPU power draw in Watts."),
])
extended_schema(DARWIN, [
  Column("total_cores", INTEGER, "The total number of GPU cores."),
  Column("allocated_vram", BIGINT, "Allocated GPU memory in bytes from IOAccelerator."),
  Column("in_use_vram", BIGINT, "In-use GPU memory in bytes from IOAccelerator."),
])
extended_schema(LINUX, [
  Column("temperature_gpu_celsius", DOUBLE, "GPU core temperature in degrees Celsius."),
  Column("power_limit_watts", DOUBLE, "Configured GPU power limit in Watts."),
  Column("fan_speed_pct", DOUBLE, "GPU fan speed as a percentage of maximum (0-100)."),
])
implementation("gpu_metrics@genGpuMetrics")
