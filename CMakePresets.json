{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 4
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "linux",
      "displayName": "Linux (osquery toolchain)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "OSQUERY_TOOLCHAIN_SYSROOT": {
          "type": "PATH",
          "value": "/usr/local/osquery-toolchain"
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Xcode)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 (Visual Studio 2022)",
      "inherits": "windows-base",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "root-required"
        }
      }
    },
    {
      "name": "linux",
      "inherits": "base",
      "configurePreset": "linux"
    },
    {
      "name": "macos",
      "inherits": "base",
      "configurePreset": "macos"
    },
    {
      "name": "windows-x64",
      "inherits": "base",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-arm64",
      "inherits": "base",
      "configurePreset": "windows-arm64",
      "configuration": "RelWithDebInfo"
    }
  ]
}
